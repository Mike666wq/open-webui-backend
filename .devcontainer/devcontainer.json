{
  "name": "Open WebUI cloud development",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "Isolated Open WebUI test backend",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "codespace",
  "postCreateCommand": "echo \"See docs/CLOUD_DEVELOPMENT.md. Start test services only when needed.\""
}
